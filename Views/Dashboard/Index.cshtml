@using TASK_9.DTOs;
@model List<UserNoteDto>
@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-4">
    <h2 class="display-5 mb-4">User's private notes:</h2>

    <div class="mb-4 text-end" style="max-width: 600px; margin: 0 auto;">
        <a asp-action="NewNote" class="btn btn-primary">Create New Note</a>
    </div>

    @if (Model.Any())
    {
        <div style="max-width: 600px; margin: 0 auto;">
            @foreach (var note in Model)
            {
                <div class="card mb-3 text-start">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@note.Title</h5>
                        <p class="card-text text-dark" style="white-space: pre-wrap;">@note.Content</p>
                        <small class="text-muted">@note.CreatedAt.ToLocalTime().ToString("g")</small>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="py-4">
            <p class="text-muted">You have no notes yet.</p>
        </div>
    }
</div>
